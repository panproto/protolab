{
  "_": "Single source of truth for the panproto-expr language tokens.",
  "_purpose": "Compiled into TextMate grammar, CodeMirror StreamLanguage, and tree-sitter grammar.",

  "language": {
    "name": "panproto-expr",
    "displayName": "Panproto Expression",
    "scopeName": "source.panproto-expr",
    "fileExtensions": [".expr", ".pexpr"],
    "lineComment": "--"
  },

  "keywords": [
    "let",
    "in",
    "where",
    "if",
    "then",
    "else",
    "case",
    "of",
    "do",
    "guard",
    "otherwise",
    "not",
    "mod",
    "div"
  ],

  "constants": [
    "True",
    "False",
    "Nothing"
  ],

  "builtins": {
    "arithmetic": [
      "add", "sub", "mul", "div", "mod_", "neg", "abs"
    ],
    "rounding": [
      "floor", "ceil", "round"
    ],
    "comparison": [
      "eq", "neq", "lt", "lte", "gt", "gte"
    ],
    "boolean": [
      "and", "or", "not"
    ],
    "string": [
      "concat", "len", "slice", "upper", "lower", "trim",
      "split", "join", "replace", "contains"
    ],
    "list": [
      "map", "filter", "fold", "append", "head", "tail",
      "reverse", "flat_map", "flatMap", "length"
    ],
    "record": [
      "merge", "merge_records", "mergeRecords",
      "keys", "values", "has_field", "hasField"
    ],
    "utility": [
      "default", "default_val", "defaultVal",
      "clamp", "truncate_str", "truncateStr"
    ],
    "coercion": [
      "int_to_float", "intToFloat",
      "float_to_int", "floatToInt",
      "int_to_str", "intToStr",
      "float_to_str", "floatToStr",
      "str_to_int", "strToInt",
      "str_to_float", "strToFloat"
    ],
    "inspection": [
      "type_of", "typeOf",
      "is_null", "isNull",
      "is_list", "isList"
    ],
    "graph": [
      "edge", "children", "has_edge", "hasEdge",
      "edge_count", "edgeCount", "anchor"
    ]
  },

  "operators": {
    "_doc": "Listed in precedence order (low → high)",
    "pipe": ["&"],
    "logicalOr": ["||"],
    "logicalAnd": ["&&"],
    "comparison": ["==", "/=", "<", "<=", ">", ">="],
    "concat": ["++"],
    "additive": ["+", "-"],
    "multiplicative": ["*", "/", "%"],
    "unary": ["-", "not"],
    "lambda": ["\\"],
    "arrow": ["->"],
    "leftArrow": ["<-"],
    "fatArrow": ["=>"],
    "binding": ["="],
    "field": ["."],
    "edge": ["->"],
    "range": [".."],
    "cons": [":"],
    "type": ["::"],
    "as": ["@"],
    "guard": ["|"],
    "backtick": ["`"]
  },

  "literals": {
    "integer": {
      "decimal": "[0-9][0-9_]*",
      "hex": "0x[0-9a-fA-F][0-9a-fA-F_]*"
    },
    "float": {
      "pattern": "[0-9][0-9_]*\\.[0-9][0-9_]*"
    },
    "string": {
      "delimiter": "\"",
      "escapes": ["\\\"", "\\\\", "\\n", "\\t", "\\r", "\\0"]
    }
  },

  "identifiers": {
    "lowercase": {
      "_doc": "Variables, fields, function names",
      "pattern": "[a-z_][a-zA-Z0-9_']*"
    },
    "uppercase": {
      "_doc": "Constructors, types",
      "pattern": "[A-Z][a-zA-Z0-9_']*"
    },
    "wildcard": "_"
  },

  "comments": {
    "line": "--"
  },

  "delimiters": {
    "parens": ["(", ")"],
    "brackets": ["[", "]"],
    "braces": ["{", "}"],
    "comma": ",",
    "semicolon": ";"
  }
}
